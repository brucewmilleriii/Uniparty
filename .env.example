# Copy to .env.local for local development. Never commit real values.

# Supabase (optional). Without these the site reads data/roster.json.
SUPABASE_URL=
# Public, read-only key used by the website (row-level security allows reads only).
SUPABASE_ANON_KEY=
# Server-side only: used by the ingest scripts to write. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# api.data.gov key (free at https://api.data.gov/signup/), used for bills from Congress.gov and, later, the FEC API.
# In GitHub, add it as the DATA_GOV_API_KEY repo secret.
DATA_GOV_API_KEY=
# OpenStates key for state legislators.
OPENSTATES_API_KEY=
